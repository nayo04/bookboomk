rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(bookmarkId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && isValidId(bookmarkId) && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }

    match /userCategories/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }
  }
}
